# ==============================================================================
# HyperLLM Local Environment Template
# Copy to `.env` before starting Docker Compose or local Spring Boot services:
#   cp .env.example .env
# ==============================================================================

# --- PostgreSQL 16 (OLTP) ---
POSTGRES_DB=hyperllm
POSTGRES_USER=hyperllm
POSTGRES_PASSWORD=hyperllm_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis 7 (L2 Cache & Rate Limit / Billing Lua) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Apache Kafka 3.9 (KRaft) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EXTERNAL_PORT=9092

# --- Debezium Connect & ClickHouse 24 (Compose --profile pipeline) ---
DEBEZIUM_PORT=8083
CLICKHOUSE_DB=hyperllm
CLICKHOUSE_USER=hyperllm
CLICKHOUSE_PASSWORD=hyperllm_dev_password
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Backend & Frontend Application Ports ---
GATEWAY_PORT=8080
CONSOLE_PORT=8081
ADMIN_PORT=8082
FRONTEND_CONSOLE_PORT=3000
FRONTEND_ADMIN_PORT=3001

# --- Observability & Developer Tools (Compose --profile observability / tools) ---
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLING_PROBABILITY=1.0
PROMETHEUS_PORT=9090
GRAFANA_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
KAFKA_UI_PORT=8088

# --- Cryptography & Dual-Domain JWT Secrets (CHANGE ALL SECRETS IN PRODUCTION!) ---
# 32-byte AES-256-GCM master key encoded in Base64 (must decode to exactly 32 bytes)
HYPERLLM_AES_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Server pepper for customer API key HMAC-SHA256 digests
HYPERLLM_KEY_PEPPER_V1=dev-only-hyperllm-key-pepper-v1-change-in-production
# Strictly isolated HS256 JWT signing keys for console vs admin domains (>= 32 bytes)
HYPERLLM_CONSOLE_JWT_SECRET=dev-only-console-jwt-secret-key-at-least-32-bytes
HYPERLLM_ADMIN_JWT_SECRET=dev-only-admin-jwt-secret-key-at-least-32-bytes
HYPERLLM_COOKIE_SECURE=false

# --- Billing & Admin Bootstrap ---
# Default $5.00 signup bonus in micro-USD (5_000_000 = $5.00; set 0 to disable)
HYPERLLM_SIGNUP_BONUS_MICROS=5000000
# Set to true in production to enforce TOTP MFA login for admin accounts
HYPERLLM_ADMIN_MFA_REQUIRED=false
HYPERLLM_BOOTSTRAP_ADMIN_EMAIL=admin@hyperllm.local
HYPERLLM_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# --- Payments (Phase 2.7) ---
# Public origin used in channel return URLs; the console host in front of this service.
HYPERLLM_PUBLIC_BASE_URL=http://localhost:8081
HYPERLLM_PAYMENT_ORDER_TTL_MINUTES=30
# Pepper for redemption code digests; keep it stable or existing codes stop matching.
HYPERLLM_VOUCHER_CODE_PEPPER=dev-only-voucher-code-pepper-change-in-production
# Units of CNY per one USD. Locked into each order, so changing it never moves an existing order.
HYPERLLM_FX_CNY_PER_USD=0.14

# Stripe Checkout (USD). Enable only when both keys are configured.
HYPERLLM_STRIPE_ENABLED=false
HYPERLLM_STRIPE_SECRET_KEY=
HYPERLLM_STRIPE_WEBHOOK_SECRET=

# Alipay desktop website payment (CNY). Keys are PKCS#8 / X.509 Base64 or PEM.
HYPERLLM_ALIPAY_ENABLED=false
HYPERLLM_ALIPAY_APP_ID=
HYPERLLM_ALIPAY_MERCHANT_PRIVATE_KEY=
HYPERLLM_ALIPAY_PUBLIC_KEY=
HYPERLLM_ALIPAY_NOTIFY_URL=http://localhost:8081/api/v1/payment-notifications/alipay
HYPERLLM_ALIPAY_RETURN_URL=/payment/return

# WeChat Pay API v3 Native (CNY). The API v3 key must be 32 bytes.
HYPERLLM_WECHAT_PAY_ENABLED=false
HYPERLLM_WECHAT_MERCHANT_ID=
HYPERLLM_WECHAT_APP_ID=
HYPERLLM_WECHAT_MERCHANT_SERIAL=
HYPERLLM_WECHAT_MERCHANT_PRIVATE_KEY=
HYPERLLM_WECHAT_API_V3_KEY=
HYPERLLM_WECHAT_PLATFORM_PUBLIC_KEY=
HYPERLLM_WECHAT_NOTIFY_URL=http://localhost:8081/api/v1/payment-notifications/wechat-pay
