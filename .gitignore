# Maven & Java build outputs
target/
out/
*.class
*.jar
*.war
*.ear

# Local environment & secrets
.env
.env.*
!.env.example

# Logs & temporary files
*.log
logs/
*.tmp
.DS_Store
Thumbs.db

# Node / Next.js fallback ignores
node_modules/
.next/

# Benchmark compiled binaries
benchmark/bin/

# Raw benchmark captures (jstat/mpstat/prom) stay out of the repo; keep curated summary CSVs.
docs/benchmark/data/*
!docs/benchmark/data/*-summary.csv
